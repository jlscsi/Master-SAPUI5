<mvc:View
    controllerName="com.logaligroup.invoice.controller.Detail"
    xmlns= "sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:rating="com.logaligroup.invoice.control"
>
  <Page  
        title="{i18n>detail}"
        showNavButton="true"
        navButtonPress="onNavToBack">
        <ObjectHeader title="{northwind>Quantity} x {northwind>ProductName}">
            <attributes>
                <ObjectAttribute text="ShipName : {northwind>ShipName}"/>
                <ObjectAttribute text="ShipAddress : {northwind>ShipAddress}"/>
                <ObjectAttribute text="ShipCity : {northwind>ShipCity}"/>
                <ObjectAttribute text="ShipRegion : {northwind>ShipRegion}"/>
                <ObjectAttribute text="ShipPostalCode : {northwind>ShipPostalCode}"/>
                <ObjectAttribute text="ShipCountry : {northwind>ShipCountry}"/>
                <ObjectAttribute text="CustomerID : {northwind>CustomerID}"/>
                <ObjectAttribute text="CustomerName : {northwind>CustomerName}"/>
            </attributes>
        </ObjectHeader>
          <rating:ProductRating id="ProductRating" class="sapUiSmallMargindBeginEnd" change="onRatingChange"/>
  </Page>

</mvc:View>