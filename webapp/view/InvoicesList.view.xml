<mvc:View
    controllerName="com.logaligroup.invoice.controller.InvoicesList"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
>
    <!--items="{invoices>/Invoices}" seria de esta forma si no se quiere agrupar es decir group by pero si se quiere agrupar se con path
        items="{
                 path: 'invoices>/Invoices',
                 sorter: {
                            path:'ShipperName',
                            group:true
                         }
                 }"
        width="auto"
    -->
    <List
        id="List"
        headerText="{i18n>invoices}"
        class="sapUiResponsiveMargin"
        items="{
                 path:'invoices>/Invoices',
                 sorter:[{
                    path:'ShipperName',
                    group:true
                 }]
                 }"
        width="auto"
    >
        <headerToolbar>
            <Toolbar>
                <Title text="{i18n>invoices}" />
                <ToolbarSpacer />
                <SearchField
                    search="onSearchPress"
                    width="50%"
                />
        <MultiComboBox
            id="multiCombo"
            width="300px"
            selectionChange="onFilterByStatus"
            items="{/ListaOpciones}"
          >
            <items>
                <core:Item
                    key="{id}"
                    core:require="{
                            MyFormatter: 'com/logaligroup/invoice/model/formatter'
                   }"
                   text="{
                   path:'description',
                   formatter: 'MyFormatter.multiComboText.bind($controller)'
                   }"/>
            </items>

        </MultiComboBox>
            </Toolbar>
        </headerToolbar>

        <items>
            <ObjectListItem
                title="{invoices>Quantity} x {invoices>ProductName}"
                number="{
                        parts:['invoices>ExtendedPrice',
                               'currency>/usd'],
                               type:'sap.ui.model.type.Currency',
                               formatOptions:{
                                  showMeasure: true 

                               }
                        }"
                numberUnit="{currency>/usd}"
                numberState="{= 
                 (${invoices>ExtendedPrice} >=100 &amp;&amp; ${invoices>ExtendedPrice} &lt;=300? 'Error':
                 (${invoices>ExtendedPrice} >300 &amp;&amp; ${invoices>ExtendedPrice} &lt;=500? 'Warning':
                 (${invoices>ExtendedPrice} >500 &amp;&amp; ${invoices>ExtendedPrice} &lt;=1000? 'Success':'Information'))) }"
            >
                <!--La linea de abajo es para formatter y en este caso es de New, In progress, Done-->
                <firstStatus>
                    <ObjectStatus
                        core:require="{
                            MyFormatter: 'com/logaligroup/invoice/model/formatter'
                   }"
                        text="{
                   path:'invoices>Status',
                   formatter: 'MyFormatter.statusText.bind($controller)'
                   }"
                    />
                </firstStatus>
            </ObjectListItem>
        </items>
    </List>
</mvc:View>
