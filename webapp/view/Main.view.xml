<mvc:View
    controllerName="com.logaligroup.invoice.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
>
    <Page title="{i18n>title}">
        <customHeader />
        <content>
            <Panel headerText="{i18n>helloPanel}">
                <Button
                    text="{i18n>showHelloButtonText}"
                    press="onShowMessage"
                />
                <Input value="{view>/recipient/name}"></Input>
            </Panel>
        </content>
    </Page>
</mvc:View>
