<core:FragmentDefinition
                xmlns="sap.m"
                xmlns:form="sap.ui.layout.form"
                xmlns:core="sap.ui.core">
        <Dialog 
                id="helloDialog"
                title="{view>/recipient/name}"> 
                <content>
                
                </content>
                <beginButton>
                    <Button
                        type="Reject"
                        text="{i18n>cancel}"
                        tooltip="{i18n>cancel}"
                        press="onCloseDialog"
                        width="4rem"/>
                </beginButton>
                <endButton>
                     <Button
                        type="Accept"
                        text="{i18n>ok}"
                        tooltip="{i18n>ok}"
                        width="4rem"/>
                </endButton>
        </Dialog>

</core:FragmentDefinition>