<mvc:View
    controllerName="com.logaligroup.employees.controller.Details"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:mvc="sap.ui.core.mvc"
>
    <uxap:ObjectPageLayout>
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title
                        text="{employees>LastName} , {employees>FirstName} ({employees>EmployeeID})"
                    />
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <Title
                        text="{employees>LastName} , ({employees>FirstName} {employees>EmployeeID})"
                    />
                </uxap:snappedHeading>

                <uxap:expandedContent>
                    <!-- <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox>
                            <VBox>
                                <Label text="{i18n>country}" />
                                <Text text="{employees>Country}" />
                            </VBox>
                        </HBox>
                        <HBox>
                            <VBox>
                                <Label text="{i18n>city}" />
                                <Text text="{employees>City}" />
                            </VBox>
                        </HBox>
                        <HBox>
                            <VBox alignItems="End">
                                <Label text="{i18n>postalCode}" />
                                <Text text="{employees>PostalCode}" />
                            </VBox>
                        </HBox>
                    </HBox> -->
                    <FlexBox
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                    >
                        <FlexBox>
                            <FlexBox direction="Column">
                                <Label text="{i18n>country}" />
                                <Text text="{employees>Country}" />
                            </FlexBox>
                        </FlexBox>
                        <FlexBox>
                            <FlexBox
                                direction="Column"
                                alignItems="Center"
                            >
                                <Label text="{i18n>city}" />
                                <Text text="{employees>City}" />
                            </FlexBox>
                        </FlexBox>
                        <FlexBox>
                            <FlexBox
                                direction="Column"
                                alignItems="End"
                            >
                                <Label text="{i18n>postalCode}" />
                                <Text text="{employees>PostalCode}" />
                            </FlexBox>
                        </FlexBox>
                    </FlexBox>
                </uxap:expandedContent>

                <uxap:snappedContent>
                    <FlexBox
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                    >
                        <FlexBox>
                            <FlexBox direction="Column">
                                <Label text="{i18n>country}" />
                                <Text text="{employees>Country}" />
                            </FlexBox>
                        </FlexBox>
                        <FlexBox>
                            <FlexBox
                                direction="Column"
                                alignItems="Center"
                            >
                                <Label text="{i18n>city}" />
                                <Text text="{employees>City}" />
                            </FlexBox>
                        </FlexBox>
                        <FlexBox>
                            <FlexBox
                                direction="Column"
                                alignItems="End"
                            >
                                <Label text="{i18n>postalCode}" />
                                <Text text="{employees>PostalCode}" />
                            </FlexBox>
                        </FlexBox>
                    </FlexBox>
                </uxap:snappedContent>
                <uxap:actions>
                    <Button
                        icon="sap-icon://decline"
                        press="onClosePress"
                        type="Transparent"
                    />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:sections />
    </uxap:ObjectPageLayout>
</mvc:View>
